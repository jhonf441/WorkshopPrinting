    "bedestimates.set",
    "bedzones.get",
    "bedzones.off",
    "bedzones.set",
    "bedzones.setpoint",
    "gcodelib.info",
    "gcodelib.layers",
    "gcodelib.list",
    "gcodelib.refresh",
    "gcodelib.thumbnail",
    "jobs.preview",
    "layerrecipes.arm",
    "layerrecipes.disarm",
    "layerrecipes.get",
    "layerrecipes.import_pellet",
    "layerrecipes.list",
    "layerrecipes.preview",
    "layerrecipes.remove",
    "layerrecipes.set",
    "layerrecipes.status",
    "machine.config.apply",
    "machine.config.plan",
    "pelletlayers.arm",
    "pelletlayers.disarm",
    "pelletlayers.get",
    "pelletlayers.list",
    "pelletlayers.remove",
    "pelletlayers.set",
    "pelletlayers.status",
    "pid.cancel",
    "pid.start",
    "pid.status",
    "pid.trace",
    "risk.end",
    "risk.start"
