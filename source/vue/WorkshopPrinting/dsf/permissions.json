    "printing:bedzone",
    "printing:file",
    "printing:folder",
    "printing:pellet",
    "printing:recipe"
  ],
  "profiles": {
    "readonly": {
      "title": "PrintingReadOnly",
      "capabilities": [
        "jobs.library",
        "jobs.view",
        "machine.config_view",
        "machine.stop",
        "machine.view"
      ]
    },
    "operator": {
      "title": "PrintingOperator",
      "capabilities": [
        "jobs.library",
        "jobs.view",
        "machine.config_view",
        "machine.stop",
        "machine.view"
      ]
    },
    "admin": {
      "title": "PrintingAdmin",
      "capabilities": [
        "jobs.library",
        "jobs.library_manage",
        "jobs.view",
        "machine.config_apply",
        "machine.config_view",
        "machine.procedures",
        "machine.stop",
        "machine.view",
        "system.bed_calibration",
        "system.bedzones",
        "system.layerrecipes",
        "system.pelletlayers"
      ]
    }
  }
